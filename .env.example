DATABASE_URL=postgresql://user:password@localhost:5432/crm_main

# --- Security & Encryption ---
ENCRYPTION_KEY=your_fernet_encryption_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Email Integration ---
SENDGRID_API_KEY=your_sendgrid_api_key
DEFAULT_SENDER_EMAIL=your_default_sender_email

# --- AI Services ---
OPENAI_API_KEY=your_openai_api_key

# --- WhatsApp Integration ---
WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_APP_SECRET=your_whatsapp_app_secret
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_secure_random_verify_token

# --- CORS Configuration ---
# Comma-separated list of allowed origins (required for security)
# Example: BACKEND_CORS_ORIGINS=["https://app.example.com","https://admin.example.com"]
BACKEND_CORS_ORIGINS=[]
